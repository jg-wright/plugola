{
  "name": "@plugola/mono-repo",
  "private": true,
  "version": "0.0.0",
  "description": "Small, composable TypeScript packages for building plugin-based applications",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean && rm -rf packages/*/dist",
    "prepare": "husky",
    "start": "tsc --build --watch",
    "test": "npm --workspaces test"
  },
  "author": "John Wright",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jg-wright/plugola.git"
  },
  "bugs": {
    "url": "https://github.com/jg-wright/plugola/issues"
  },
  "homepage": "https://github.com/jg-wright/plugola#readme",
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "^21.2.3",
    "@types/node": "26.6.6",
    "@vitest/runner": "4.1.11",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.{md,json,js,jsx,ts,tsx,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "tslib": "2.9.1"
  }
}
