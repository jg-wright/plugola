{
  "name": "@plugola/vendor-plugin-manager",
  "version": "4.0.5",
  "description": "A plugin manager that only enables the plugins a user has consented to",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean && rimraf dist",
    "start": "tsc --watch --preserveWatchOutput",
    "test": "vitest --run && tsc -p test/tsconfig.json"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jg-wright/plugola/issues"
  },
  "repository": {
    "url": "https://github.com/jg-wright/plugola"
  },
  "homepage": "https://github.com/jg-wright/plugola#readme",
  "devDependencies": {
    "@plugola/plugin-manager": "9.0.1",
    "@types/node": "25.9.2",
    "@vitest/runner": "4.1.8",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@plugola/plugin-manager": "^9.0.1"
  }
}
