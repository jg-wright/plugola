{
  "name": "@plugola/queue",
  "version": "0.0.0",
  "description": "Runnable queues that buffer while stopped and drain on start",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean && rimraf dist",
    "start": "tsc --watch --preserveWatchOutput",
    "test": "vitest --run && npm run test:types",
    "test:types": "tsc -p test/tsconfig.json"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jg-wright/plugola/issues"
  },
  "repository": {
    "url": "https://github.com/jg-wright/plugola"
  },
  "homepage": "https://github.com/jg-wright/plugola#readme",
  "devDependencies": {
    "@types/node": "25.9.2",
    "@vitest/runner": "4.1.8",
    "rimraf": "6.1.3",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
